# ══════════════════════════════════════════════════════════════════════════════
# Agentic Plant Disease Diagnosis — configuration
# Copy this file to `.env` and fill in your values. `.env` is gitignored.
# ══════════════════════════════════════════════════════════════════════════════

# ── LLM (OpenRouter, OpenAI-API-compatible) ──────────────────────────────────
# Paste your real key into `.env` (NOT here). Leave this file's value empty.
OPENROUTER_API_KEY= 
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Any OpenRouter model id, e.g. openai/gpt-4o-mini, meta-llama/llama-3.1-8b-instruct
OPENROUTER_MODEL=

# ── Vision ───────────────────────────────────────────────────────────────────
# "mock" (synthetic, no images needed) or "ensemble" (real checkpoints).
VISION_MODE=mock
# Directory of real test images (used when VISION_MODE=ensemble). Per-class
# subfolders named exactly as model/class_names.json entries.
TEST_IMAGE_DIR=data/test_images

# ── Retrieval ────────────────────────────────────────────────────────────────
# Absolute or project-relative path to the FAISS index built by
# rag/rag/index_corpus.py. Default matches the RAG project's own FAISS_INDEX_DIR.
FAISS_INDEX_DIR=rag/rag/data/faiss_index
RETRIEVAL_TOP_K=5
